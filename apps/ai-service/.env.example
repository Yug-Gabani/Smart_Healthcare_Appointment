# OpenRouter API Key for LangChain / LangGraph LLM inference
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model identifier (e.g. anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001, meta-llama/llama-3.3-70b-instruct)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Service Port
PORT=8001

