# =============================================================================
# PulseCare ai-service — LLM provider configuration
#
# Pick ONE provider. The factory prefers Google when GOOGLE_API_KEY is set,
# otherwise falls back to OpenRouter. When neither is set the service still
# runs — it just uses the deterministic rule engine for everything.
# =============================================================================

# ---- Option A: Google AI Studio (free tier, recommended for student demo) ---
# Get a free key in 30 seconds: https://aistudio.google.com/apikey
# Free quota: ~15 requests/min, ~1,500/day on Flash Lite. No credit card needed.
GOOGLE_API_KEY=your_google_ai_studio_key_here
GOOGLE_MODEL=gemini-2.5-flash-lite

# ---- Option B: OpenRouter (paid; broad model catalog including Claude) ------
# Leave blank if using Option A.
# Get a key: https://openrouter.ai/keys (requires credit)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ---- Service port -----------------------------------------------------------
PORT=8001

