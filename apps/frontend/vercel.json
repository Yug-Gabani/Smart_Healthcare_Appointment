{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://smart-healthcare-appointment-lp91.onrender.com/api/:path*"
    },
    {
      "source": "/ai/:path*",
      "destination": "https://pulsecare-ai-5s2a.onrender.com:path*"
    },
    {
      "source": "/((?!api|ai).*)",
      "destination": "/index.html"
    }
  ]
}
